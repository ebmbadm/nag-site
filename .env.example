# Runtime environment for the NAG · NOVIK site (server-side only; not needed at build).
# Copy to .env and fill in. Pass to the container via `--env-file .env`.

# Supabase — backs the contact-form server action (app/actions/submit-inquiry.ts)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notifications on new inquiry (optional — lib/notifications.ts skips if unset)
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deploy target — NOT read by the app. Reference for manual ssh; mirrors the
# GitHub Actions secret names in .github/workflows/deploy.yml. Key path only,
# never the key itself.
DEPLOY_SSH_ALIAS=
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_KEY=
DEPLOY_PATH=/opt/nag-site
